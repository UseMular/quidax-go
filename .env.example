# Non-secret local overrides. Copy to .env only when overriding defaults.
APP_PORT=55059
MYSQL_DATABASE=quidax-go
MYSQL_USER=quidax
TIGERBEETLE_VERSION=0.16.11
TIGERBEETLE_CACHE_GRID=256MiB
BACKEND_NETWORK_NAME=quidax_backend

# Secret file paths may be overridden without exposing secret values here.
MYSQL_PASSWORD_FILE=./secrets/mysql_password
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password
